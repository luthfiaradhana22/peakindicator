# Salin file ini jadi .streamlit/secrets.toml (untuk run lokal)
# atau paste isinya ke Settings > Secrets di Streamlit Community Cloud.

jsonbin_api_key = "GANTI_DENGAN_X-MASTER-KEY_DARI_JSONBIN"
jsonbin_bin_id  = "GANTI_DENGAN_BIN_ID_DARI_JSONBIN"

# 4 orang yang berhak nyentang tile. Ganti nama & password masing-masing.
# Member lain (di luar daftar ini) yang buka link cuma bisa lihat, tidak bisa login.
[admins]
Nama1 = "GANTI_PASSWORD_1"
Nama2 = "GANTI_PASSWORD_2"
Nama3 = "GANTI_PASSWORD_3"
Nama4 = "GANTI_PASSWORD_4"
